{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skytog/llm-hayasa-jp-bench/specs/result-schema.json",
  "title": "llm-hayasa-jp-bench artifacts",
  "description": "results.json（run の配列）, manifest_<SUT>.json, attempts.jsonl の1行 を記述する。指標定義は specs/metrics.md。",
  "$defs": {
    "attempt": {
      "type": "object",
      "required": ["task", "run", "passed", "state", "elapsed"],
      "properties": {
        "task": { "type": "string" },
        "run": { "type": "integer", "minimum": 0 },
        "passed": { "type": "boolean" },
        "state": {
          "enum": ["pass", "wrong_answer", "format_violation", "budget_exhausted",
                   "empty", "truncated", "http_error", "timeout", "error", "grader_error"]
        },
        "detail": { "type": ["string", "null"] },
        "elapsed": { "type": ["number", "null"] },
        "ttft_any": { "type": ["number", "null"] },
        "ttft_answer": { "type": ["number", "null"] },
        "prompt_tokens": { "type": ["integer", "null"] },
        "completion_tokens": { "type": ["integer", "null"] },
        "finish_reason": { "type": ["string", "null"] },
        "done_seen": { "type": ["boolean", "null"] },
        "parse_errors": { "type": ["integer", "null"] },
        "usage_available": { "type": ["boolean", "null"] },
        "degraded": { "type": ["boolean", "null"] },
        "usage": { "type": ["object", "null"] },
        "l": { "type": ["number", "null"] },
        "reasoning_chars": { "type": ["integer", "null"] },
        "content_chars": { "type": ["integer", "null"] },
        "reasoning_repeat_ratio": { "type": ["number", "null"] },
        "reasoning_head": { "type": ["string", "null"] },
        "reasoning_tail": { "type": ["string", "null"] },
        "reasoning": { "type": ["string", "null"] },
        "output": { "type": ["string", "null"] },
        "sut": { "type": "string" },
        "run_id": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "required": ["model", "tasks", "per_task", "summary"],
      "properties": {
        "model": { "type": "string" },
        "speed": { "type": ["object", "null"] },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
        "per_task": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task", "pass", "rate"],
            "properties": {
              "task": { "type": "string" },
              "pass": { "type": "string" },
              "rate": { "type": "number" },
              "mean_time_s": { "type": ["number", "null"] }
            }
          }
        },
        "summary": {
          "type": "object",
          "required": ["task_runs", "task_passes", "success_rate"],
          "properties": {
            "task_runs": { "type": "integer", "minimum": 0 },
            "task_passes": { "type": "integer", "minimum": 0 },
            "success_rate": { "type": "number" },
            "success_rate_ci95": { "type": ["array", "null"], "items": { "type": "number" } },
            "task_pass_rate": { "type": ["number", "null"] },
            "task_pass_ci95": { "type": ["array", "null"], "items": { "type": "number" } },
            "quality_rate": { "type": ["number", "null"] },
            "grader_errors": { "type": ["integer", "null"] },
            "degraded": { "type": ["boolean", "null"] },
            "mean_task_time_s": { "type": ["number", "null"] },
            "time_to_pass_s": { "type": ["number", "null"] },
            "mean_reasoning_repeat": { "type": ["number", "null"] },
            "states": { "type": ["object", "null"] }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": ["schema_version", "run_id", "created_at", "sut", "endpoint", "protocol", "dataset", "grader"],
      "properties": {
        "schema_version": { "const": "0.1" },
        "run_id": { "type": "string" },
        "created_at": { "type": "string" },
        "sut": { "type": "object", "required": ["name", "engine", "gpu", "sampling"] },
        "endpoint": { "type": "object" },
        "protocol": { "type": "object" },
        "dataset": { "type": "object" },
        "grader": { "type": "object" }
      }
    }
  },
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/run" } },
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/attempt" }
  ]
}
